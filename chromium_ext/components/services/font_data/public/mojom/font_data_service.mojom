module font_data_service.mojom;

import "mojo/public/mojom/base/file.mojom";
import "mojo/public/mojom/base/shared_memory.mojom";

struct FontFallbackInfo {
  string? language;
  string familyName;
};

struct FontAdjustInfo {
  int32 weight;
  int32 to;
};

struct FontAliasInfo {
  string familyName;
  int32 weight;
};

struct FontFallbackGroup {
  string? groupName;
  uint64 fallbackInfoSize;
  array<FontFallbackInfo> fallbackInfoSet;
};

struct FontGenericInfo {
  string familyName;
  uint64 aliasInfoSize;
  uint64 adjustInfoSize;
  array<FontAliasInfo> aliasInfoSet;
  array<FontAdjustInfo> adjustInfoSet;
};

// Stylish font descriptor info for buildStyleNameToFamilyMap.
// Replaces direct NDK calls (GetSystemFontFullNamesByType +
// GetFontDescriptorByFullName) in the renderer process.
struct FontStylishInfo {
  string familyName;
  string path;
};

struct FontConfigInfo {
  uint64 fontDirSize;
  uint64 fontGenericInfoSize;
  uint64 fallbackGroupSize;
  array<string> fontDirSet;
  array<FontGenericInfo> fontGenericInfoSet;
  array<FontFallbackGroup> fallbackGroupSet;
};

// Loads and resolves fonts from the renderer to the browser (embedder). Takes
// requests by font family name and style and resolves it with the matching
// typeface.
//
// Created on renderer process startup when constructing the font manager.
interface FontDataService {
  [Sync]
  GetFontConfigInfo() => (FontConfigInfo? result);

  // Returns the list of stylish fonts (familyName + path) for the given
  // fontType. fontType corresponds to ArkWeb_Drawing_SystemFontType enum.
  [Sync]
  GetStylishFontList(int32 fontType) => (array<FontStylishInfo>? result);
};
