import("//chrome/common/extensions/api/api_sources.gni")
import("//tools/json_schema_compiler/json_schema_api.gni")

assert(is_arkweb,
       "ArkWeb extension API types are only available in ArkWeb builds.")

generated_types("generated_arkweb_api_types") {
  sources = [ "//arkweb/chromium_ext/chrome/common/extensions/api/hwext_actor.idl" ]
  configs = [ "//build/config:precompiled_headers" ]
  schema_include_rules = chrome_extensions_api_schema_include_rules
  root_namespace = chrome_extensions_api_root_namespace
  deps = [ "//extensions/common/api" ]
}

generated_json_strings("generated_arkweb_api_json_strings") {
  sources = [ "//arkweb/chromium_ext/chrome/common/extensions/api/hwext_actor.idl" ]
  configs = [ "//build/config:precompiled_headers" ]
  bundle_name = "ArkWeb"
  schema_include_rules = chrome_extensions_api_schema_include_rules
  root_namespace = chrome_extensions_api_root_namespace
  deps = [ "//extensions/common/api" ]
}
