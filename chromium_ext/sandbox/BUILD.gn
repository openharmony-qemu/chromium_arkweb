import("//build/config/features.gni")
import("//sandbox/features.gni")
import("//testing/test.gni")

config("no_inline_config") {
  cflags = [ "-fno-inline" ]
}

source_set("arkweb_sandbox") {
  sources = [
    "seccomp-bpf-helpers/baseline_policy_ohos.cc",
    "seccomp-bpf-helpers/baseline_policy_ohos.h",
  ]

  configs += [ ":no_inline_config" ]

  deps = [
    "//base",
    "//sandbox:sandbox_export",
  ]
}

source_set("seccomp_starter_ohos") {
  sources = [
    "seccomp-bpf-helpers/seccomp_starter_ohos.cc",
    "seccomp-bpf-helpers/seccomp_starter_ohos.h",
  ]

  deps = [ "//base" ]

  if (use_seccomp_bpf) {
    deps += [ "//sandbox/linux:seccomp_bpf" ]
  }
}

test("arkweb_sandbox_unittests") {
  include_dirs = [ "//ppapi/lib/gl/include" ]

  sources = [
    "//sandbox/linux/tests/main.cc",
    "seccomp-bpf-helpers/baseline_policy_ohos_unittest.cc",
    "seccomp-bpf-helpers/seccomp_starter_ohos_unittest.cc",
  ]

  defines = [ "SANDBOX_IMPLEMENTATION" ]

  public_deps = [
    "//testing/gmock",
    "//testing/gtest",
  ]

  deps = [
    ":arkweb_sandbox",
    ":seccomp_starter_ohos",
    "//base",
    "//base/test:test_support",
    "//sandbox:sandbox_export",
    "//sandbox/linux:seccomp_bpf",
    "//sandbox/linux:sandbox_linux_test_utils",
  ]

  if (is_ohos) {
    deps += [ "//sandbox/linux:seccomp_bpf" ]
  }

}