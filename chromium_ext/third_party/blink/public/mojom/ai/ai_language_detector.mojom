module blink.mojom;

import "third_party/blink/public/mojom/ai/model_streaming_responder.mojom";

// Interface for AILanguageDetection that can stream the output string.
interface AILanguageDetector {
  // Translate the input from the source language to the target language.
  Detect(string input,
         pending_remote<ModelStreamingResponder> pending_responder);
};
