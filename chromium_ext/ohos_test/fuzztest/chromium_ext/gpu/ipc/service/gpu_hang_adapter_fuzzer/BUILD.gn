    "gpu_hang_adapter_fuzzer.cc",
  ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
  ]
  deps = [
    "//arkweb/ohos_adapter_ndk:adapter_ndk_stub",
    "//base",
    "//base/test:test_support",
    "//cef:libcef_static",
    "//gpu/ipc/service:service",
    "//ohos_nweb:nweb_sources",
    "//third_party/googletest:gtest",
    "//third_party/googletest:gmock",
  ]
}

group("ohos_fuzzers") {
  testonly = true
  deps = [
    ":gpu_hang_adapter_fuzzer",
  ]
}

