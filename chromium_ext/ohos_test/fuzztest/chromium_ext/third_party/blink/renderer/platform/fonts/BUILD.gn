import("//build/config/features.gni")
import("//testing/libfuzzer/fuzzer_test.gni")

config("font_platform_data_utils_fuzzer_config") {
  defines = [
    "BLINK_IMPLEMENTATION=1",
    "INSIDE_BLINK",
  ]
  if (is_clang) {
    cflags = [
      "-Wno-implicit-float-conversion",
      "-Wno-implicit-int-conversion",
    ]
  }
}

fuzzer_test("font_platform_data_utils_fuzzer") {
  sources = [
    "font_platform_data_utils_fuzzer.cc",
  ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
    "//v8/include",
    "//third_party/blink",
    "//third_party/blink/renderer/core",
    "//arkweb/chromium_ext",
    "//arkweb/build/features",
  ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
    "//third_party/blink/renderer/platform",
    "//third_party/blink/renderer/platform:blink_fuzzer_test_support",
    "//third_party/googletest:gtest",
    "//content/test:test_support",
    "//base",
  ]
  additional_configs = [ ":font_platform_data_utils_fuzzer_config" ]
}

group("platform_fonts_fuzzers") {
  testonly = true
  deps = [
    ":font_platform_data_utils_fuzzer",
  ]
}