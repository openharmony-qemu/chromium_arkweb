import("//build/buildflag_header.gni")
import("//build/config/features.gni")
import("//build/config/ohos/config.gni")
import("//ohos_nweb/src/nweb_sysevent.gni")
import("//tools/grit/grit_rule.gni")
import("//tools/grit/repack.gni")
import("//testing/libfuzzer/fuzzer_test.gni")
import("//testing/test.gni")
import("//arkweb/build/features/features.gni")

fuzzer_test("detect_simulated_click_risk_fuzzer") {
  sources = [ "detect_simulated_click_risk_fuzzer.cpp" ]
  defines = [
    "INSIDE_BLINK",
    "BLINK_IMPLEMENTATION=1",
  ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//third_party/ohos_ndk/includes/ohos_adapter",
    "//third_party/blink",
    "//v8/include",
  ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:nweb_sources",
    "//third_party/blink/renderer/core:testing",
    "//third_party/blink/renderer/platform:blink_fuzzer_test_support",
    "//third_party/googletest:gtest",
    "//third_party/googletest:gmock",
  ]
}

group("ohos_test") {
    testonly = true
    deps = []
    deps += [
      ":detect_simulated_click_risk_fuzzer",
    ]
}