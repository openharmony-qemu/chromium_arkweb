import("//build/config/features.gni")
import("//testing/libfuzzer/fuzzer_test.gni")

fuzzer_test("arkweb_elide_url_ext_fuzzer") {
  sources = [ "arkweb_elide_url_ext_fuzzer.cc" ]
  include_dirs = [
    "//cef",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
  ]
  deps = [
    "//base",
    # arkweb_elide_url_ext.cc (ParseInput) is compiled into this static
    # library when is_arkweb is true; see components/url_formatter/BUILD.gn.
    "//components/url_formatter:url_formatter",
    "//url",
  ]
}

## Url Formatter Fuzzers
group("url_formatter_fuzzers") {
  testonly = true
  deps = [
    ":arkweb_elide_url_ext_fuzzer",
  ]
}
