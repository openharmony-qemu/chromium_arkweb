import("//build/config/features.gni")
import("//testing/libfuzzer/fuzzer_test.gni")

fuzzer_test("nweb_native_window_tracker_fuzzer") {
  sources = [ "nweb_native_window_tracker_fuzzer.cpp" ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//third_party/ohos_ndk/includes/ohos_adapter",
    "//chromium_ext",
  ]
  deps = [
    "//base",
    "//gpu/ipc/common",
    "//third_party/googletest:gtest",
    "//arkweb/build/features",
    "//content/public/common",
    "//components/subresource_filter/content/browser",
    "//cef:libcef_static",
  ]
}

fuzzer_test("gpu_surface_id_tracker_fuzzer") {
  sources = [ "gpu_surface_id_tracker_fuzzer.cpp" ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//chromium_ext",
    "//ui/gfx",
  ]
  deps = [
    "//base",
    "//gpu/ipc/common",
    "//ui/gfx",
    "//third_party/googletest:gtest",
    "//content/public/common",
    "//components/subresource_filter/content/browser",
    "//cef:libcef_static",
  ]
}

group("ohos_fuzz") {
  testonly = true
  deps = [
    ":nweb_native_window_tracker_fuzzer",
    ":gpu_surface_id_tracker_fuzzer",
  ]
}