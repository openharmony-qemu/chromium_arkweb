import("//build/config/features.gni")
import("//testing/libfuzzer/fuzzer_test.gni")

config("gpu_channel_for_include_fuzzer_config") {
  cflags = [
    "-Wno-thread-safety-analysis",
  ]
}

# Fuzzer for GpuChannelMessageFilter operations (gpu_channel_for_include.cc)
# Tests CreateNativeTexture and SetBlanklessDumpInfo parameter validation
fuzzer_test("gpu_channel_for_include_fuzzer") {
  sources = [
    "gpu_channel_for_include_fuzzer.cpp",
    "//gpu/ipc/service/gpu_channel_test_common.cc",
  ]
  include_dirs = [
    "//",
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//arkweb/chromium_ext",
    "//gpu/ipc/service",
  ]
  deps = [
    "//base",
    "//gpu/ipc/service",
    "//gpu/command_buffer/service",
    "//ui/gl",
    "//cef:libcef_static",
    "//arkweb/build/features",
    "//testing/gmock",
    "//testing/gtest",
    "//base/test:test_support",
    "//components/subresource_filter/content/mojom",
    "//components/subresource_filter/core/common",
    "//components/subresource_filter/core/common:test_support",
    "//third_party/blink/public:blink",
    "//url",
    "//components/subresource_filter/core/browser",
    "//ui/gl:test_support",
  ]
  additional_configs = [ ":gpu_channel_for_include_fuzzer_config" ]
}

