# Group for all gpu/ipc/service fuzzers
group("ohos_fuzz") {
  testonly = true
  deps = [
    ":gpu_channel_for_include_fuzzer",
    ":stream_texture_ohos_fuzzer",
    ":gpu_channel_ext_fuzzer",
  ]
}
