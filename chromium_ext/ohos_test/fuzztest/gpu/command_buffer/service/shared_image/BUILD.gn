    "ohos_native_buffer_image_backing_fuzzer.cpp",
  ]
  include_dirs = [
    "//cef",
    "//ohos_nweb/include",
    "//arkweb/ohos_adapter_ndk/interfaces",
    "//arkweb/ohos_adapter_ndk/ohos_native_buffer_adapter",
