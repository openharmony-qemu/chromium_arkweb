import("//build/config/features.gni")
import("//testing/libfuzzer/fuzzer_test.gni")

# Define a local config similar to inside_blink for external fuzzer use
config("fetch_fuzzer_blink_config") {
  defines = [
    "BLINK_IMPLEMENTATION=1",
    "INSIDE_BLINK",
  ]
  if (is_clang) {
    cflags = [
      "-Wconversion",
      "-Wno-float-conversion",
      "-Wno-sign-conversion",
      "-Wno-implicit-float-conversion",
      "-Wno-implicit-int-conversion",
    ]
  }
}

# Fuzzer for ResourceFinishAsError (resource_fetcher_for_include.cc) - Priority 1 (AdBlock)
# Tests the adblock finish-as-error path with blocking/allowing contexts and URLs
fuzzer_test("resource_fetcher_for_include_fuzzer") {
  sources = [ "resource_fetcher_for_include_fuzzer.cpp" ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
    "//third_party/blink/renderer/platform",
    "//third_party/blink/renderer/platform:blink_fuzzer_test_support",
    "//third_party/googletest:gtest",
    "//content/test:test_support",
  ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
    "//v8/include",
    "//third_party/blink",
    "//third_party/blink/renderer/core",
    "//arkweb/chromium_ext",
  ]
  additional_configs = [ ":fetch_fuzzer_blink_config" ]
}

# Fuzzer for ResourceRequestSender::OnTransferDataWithSharedMemory - Priority 2 (Resource Interception)
# Tests shared-memory transfer with null/valid/empty regions and notifier wrappers
fuzzer_test("resource_request_sender_ext_fuzzer") {
  sources = [ "url_loader/resource_request_sender_ext_fuzzer.cpp" ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
    "//third_party/blink/renderer/platform",
    "//third_party/blink/renderer/platform:blink_fuzzer_test_support",
    "//third_party/googletest:gtest",
    "//content/test:test_support",
  ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
    "//v8/include",
    "//third_party/blink",
    "//third_party/blink/renderer/core",
    "//arkweb/chromium_ext",
  ]
  additional_configs = [ ":fetch_fuzzer_blink_config" ]
}

# Fuzzer for SyncLoadContext::OnTransferDataWithSharedMemory - Priority 3 (Resource Interception)
# Tests shared-memory sync load with valid/invalid/size-mismatched regions
fuzzer_test("sync_load_context_for_include_fuzzer") {
  sources = [ "url_loader/sync_load_context_for_include_fuzzer.cpp" ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
    "//third_party/blink/renderer/platform",
    "//third_party/blink/renderer/platform:blink_fuzzer_test_support",
    "//third_party/googletest:gtest",
    "//content/test:test_support",
  ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
    "//v8/include",
    "//third_party/blink",
    "//third_party/blink/renderer/core",
    "//arkweb/chromium_ext",
  ]
  additional_configs = [ ":fetch_fuzzer_blink_config" ]
}

# Group for all platform/loader/fetch module fuzzers
group("fetch_fuzzers") {
  testonly = true
  deps = [
    ":resource_fetcher_for_include_fuzzer",
    ":resource_request_sender_ext_fuzzer",
    ":sync_load_context_for_include_fuzzer",
  ]
}
