import("//build/buildflag_header.gni")
import("//build/config/features.gni")
import("//build/config/ohos/config.gni")
import("//ohos_nweb/src/nweb_sysevent.gni")
import("//tools/grit/grit_rule.gni")
import("//tools/grit/repack.gni")
import("//testing/libfuzzer/fuzzer_test.gni")
import("//testing/test.gni")
import("//arkweb/build/features/features.gni")
import("//third_party/blink/renderer/core/dom/build.gni")

fuzzer_test("paint_timing_detector_utils_fuzzer") {
  sources = [ "paint_timing_detector_utils_fuzzer.cc" ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
    "//v8/include",
    "//third_party/blink",
    "//third_party/blink/renderer/core",
    "//arkweb/chromium_ext",
  ]

  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
    "//third_party/blink/renderer/platform",
    "//third_party/blink/renderer/platform:blink_fuzzer_test_support",
    "//third_party/blink/renderer/core:unit_test_support",
    "//third_party/googletest:gtest",
    "//content/test:test_support",
  ]
  defines = [
    "INSIDE_BLINK",
  ]
}

group("ohos_fuzz") {
  testonly = true
  deps = [
    ":paint_timing_detector_utils_fuzzer",
  ]
}
