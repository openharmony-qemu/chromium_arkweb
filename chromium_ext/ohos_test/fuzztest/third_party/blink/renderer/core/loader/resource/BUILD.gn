fuzzer_test("css_style_sheet_resource_utils_fuzzer") {
  sources = [ "css_style_sheet_resource_utils_fuzzer.cc" ]
  include_dirs = [
    "//cef",
    "//ohos_newb/include",
    "//ohos_newb/src",
    "//v8/include",
    "//third_party/blink",
  ]

  deps = [
    "//cef:libcef_static",
    "//base/test:test_support",
    "//content/test:test_support",
  ]
  defines = [
    "INSIDE_BLINK",
  ]
}

