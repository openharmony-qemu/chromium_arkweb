# Group for all resource loader fuzzers
group("ohos_fuzz") {
  testonly = true
  deps = [
    ":css_style_sheet_resource_utils_fuzzer",
    ":image_resource_utils_fuzzer",
    ":script_resource_utils_fuzzer",
