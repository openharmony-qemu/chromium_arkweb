import("//build/config/features.gni")
import("//testing/libfuzzer/fuzzer_test.gni")

# Define a local config similar to inside_blink for external fuzzer use
config("loader_fuzzer_blink_config") {
  defines = [
    "BLINK_IMPLEMENTATION=1",
    "INSIDE_BLINK",
  ]
  if (is_clang) {
    cflags = [
      "-Wconversion",
      "-Wno-float-conversion",
      "-Wno-sign-conversion",
      "-Wno-implicit-float-conversion",
      "-Wno-implicit-int-conversion",
    ]
  }
}

# Fuzzer for ArkWebSubresourceFilterExt - Priority 1 (AdBlock)
# Tests subresource filter extension methods with various load policies and URLs
fuzzer_test("arkweb_subresource_filter_ext_fuzzer") {
  sources = [ "arkweb_subresource_filter_ext_fuzzer.cpp" ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
    "//third_party/blink/renderer/platform",
    "//third_party/blink/renderer/platform:blink_fuzzer_test_support",
    "//third_party/googletest:gtest",
    "//content/test:test_support",
  ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
    "//v8/include",
    "//third_party/blink",
    "//third_party/blink/renderer/core",
    "//arkweb/chromium_ext",
  ]
  additional_configs = [ ":loader_fuzzer_blink_config" ]
}

# Fuzzer for BaseFetchContextUtil::CanRequestBasedOnSubresourceFilterOnlyForInclude - Priority 2 (AdBlock)
# Tests subresource-filter-only request checks with null/allowing/blocking filters
fuzzer_test("base_fetch_context_for_include_fuzzer") {
  sources = [ "base_fetch_context_for_include_fuzzer.cpp" ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
    "//third_party/blink/renderer/platform",
    "//third_party/blink/renderer/platform:blink_fuzzer_test_support",
    "//third_party/googletest:gtest",
    "//third_party/googletest:gmock",
    "//content/test:test_support",
  ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
    "//v8/include",
    "//third_party/blink",
    "//third_party/blink/renderer/core",
    "//arkweb/chromium_ext",
  ]
  additional_configs = [ ":loader_fuzzer_blink_config" ]
}

# Fuzzer for ArkWebDocumentLoaderExt - Priority 3 (Document loading)
# Tests document loader extension adblock/image-cache/preload/blankless paths
fuzzer_test("arkweb_document_loader_ext_fuzzer") {
  sources = [ "arkweb_document_loader_ext_fuzzer.cpp" ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
    "//third_party/blink/renderer/platform",
    "//third_party/blink/renderer/platform:blink_fuzzer_test_support",
    "//third_party/googletest:gtest",
    "//content/test:test_support",
  ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
    "//v8/include",
    "//third_party/blink",
    "//third_party/blink/renderer/core",
    "//arkweb/chromium_ext",
  ]
  additional_configs = [ ":loader_fuzzer_blink_config" ]
}

# Group for all core/loader module fuzzers
group("loader_fuzzers") {
  testonly = true
  deps = [
    ":arkweb_subresource_filter_ext_fuzzer",
    ":base_fetch_context_for_include_fuzzer",
    ":arkweb_document_loader_ext_fuzzer",
  ]
}
