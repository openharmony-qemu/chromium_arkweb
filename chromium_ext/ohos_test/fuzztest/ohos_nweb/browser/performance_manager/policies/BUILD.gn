import("//build/config/features.gni")
import("//testing/libfuzzer/fuzzer_test.gni")

fuzzer_test("background_task_policy_fuzzer") {
  sources = [ "./background_task_policy_fuzzer.cc" ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
    "//ohos_nweb/browser/performance_manager/policies",
    "//ohos_nweb/browser/performance_manager/mechanisms",
  ]
  deps = [
    "//arkweb/ohos_adapter_ndk:adapter_ndk_stub",
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
  ]
}

fuzzer_test("ohos_bfcache_policy_fuzzer") {
  sources = [ "./ohos_bfcache_policy_fuzzer.cc" ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
    "//ohos_nweb/browser/performance_manager/policies",
  ]
  deps = [
    "//arkweb/ohos_adapter_ndk:adapter_ndk_stub",
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
  ]
}

group("performance_policy_fuzzers") {
  testonly = true
  deps = [
    ":background_task_policy_fuzzer",
    ":ohos_bfcache_policy_fuzzer",
  ]
}
