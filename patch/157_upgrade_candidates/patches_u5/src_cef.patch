+  
+  bool should_use = false;
+  if (!should_use) {
+    timer.Stop();
+  }
+  
+  EXPECT_FALSE(timer.IsRunning());
+}
+
+TEST_F(CefRenderWidgetHostViewOSRTimerTest, Policy_MultipleEnableCalls) {
+  base::OneShotTimer timer;
+  
+  timer.Start(FROM_HERE, base::Seconds(10), base::DoNothing());
