+bool ValidateResultType(base::Value::Type type) {
+  if (type == base::Value::Type::STRING || type == base::Value::Type::DOUBLE ||
+      type == base::Value::Type::INTEGER ||
+      type == base::Value::Type::BOOLEAN) {
