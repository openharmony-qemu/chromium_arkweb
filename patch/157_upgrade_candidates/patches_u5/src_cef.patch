+FallbackProxyService::~FallbackProxyService() {
+  network_connection_tracker_->RemoveNetworkConnectionObserver(this);
+  ArkwebGlobalListConfig::GetInstance()->RemoveConfigChangeObservers(
+      kFallbackProxyBlockList);
