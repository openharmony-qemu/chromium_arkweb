+void ArkWebBrowserHostExtImpl::EnableAdsBlock(bool enable) {
+  if (!GetWebContents()) {
+    return;
+  }
+  GetWebContents()->EnableAdsBlock(enable);
+
+#if BUILDFLAG(ARKWEB_LOGGER_REPORT)
+  LOG_FEEDBACK(INFO) << "web adblock enabled :" << enable;
+#endif
+
+  OHOS::adblock::AdBlockConfig::GetInstance()->ReadFromPrefService();
+  if (!OHOS::adblock::AdBlockConfig::GetInstance()
+           ->GetUserEasylistReplaceSwitch() &&
+      enable) {
+
+#if BUILDFLAG(ARKWEB_LOGGER_REPORT)
+    LOG_FEEDBACK(INFO) << "[Adblock] enable cloud control for easylist";
+#endif
+
+#if BUILDFLAG(IS_ARKWEB_EXT)
+    ohos_adblock::AdblockConfigBridge::GetInstance()->EnableAdsBlock(true);
+  } else {
+    ohos_adblock::AdblockConfigBridge::GetInstance()->EnableAdsBlock(false);
+  }
+#else
+    ohos_adblock::AdblockConfigBridge::GetInstance()->EnableAdsBlock(GetBrowserContext(), true);
+  } else {
+    ohos_adblock::AdblockConfigBridge::GetInstance()->EnableAdsBlock(GetBrowserContext(), false);
+  }
+#endif
