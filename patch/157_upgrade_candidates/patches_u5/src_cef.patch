+#if BUILDFLAG(ARKWEB_SAFEBROWSING)
+void ArkwebFrameHostExtImpl::RequestSnapshotOnce(){
+  if (auto* host = content::GpuProcessHost::Get()) {
+    if (auto* host_impl = host->gpu_host()) {
+      host_impl->RequestSnapshotOnce();
+    }
+  }
+}
+#endif
