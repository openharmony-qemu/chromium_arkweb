+  /* ohos webview add*/
+  settings_.force_dark_mode_enabled = browser_settings.force_dark_mode_enabled;
+#if BUILDFLAG(ARKWEB_DARKMODE)
+  settings_.dark_prefer_color_scheme_enabled =
+      browser_settings.dark_prefer_color_scheme_enabled;
