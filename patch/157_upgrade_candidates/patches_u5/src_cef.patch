+
+void OhGinJavascriptBridgeDispatcherHost::InvokeMethod(const std::string& method_name,
+                                                       const std::string& document_url,
+                                                       base::Value::List arguments,
+                                                       InvokeMethodCallback callback) {
+  bool isAsyncthread = false;
+  OnHasAsyncThreadMethod(object_receivers_.current_context().second, method_name, &isAsyncthread);
+  if (isAsyncthread) {
+    async_task_runner_->PostTask(
+        FROM_HERE, base::BindOnce(&OhGinJavascriptBridgeDispatcherHost::InvokeMethodInternal,
+                                  base::Unretained(this),
+                                  object_receivers_.current_context().first.frame_routing_id,
+                                  object_receivers_.current_context().second, method_name, document_url,
+                                  std::move(arguments), std::move(callback)));
+  } else {
+    InvokeMethodInternal(object_receivers_.current_context().first.frame_routing_id,
+                         object_receivers_.current_context().second, method_name, document_url,
+                         std::move(arguments), std::move(callback));
+  }
+}
+
+void OhGinJavascriptBridgeDispatcherHost::InvokeMethodInternal(int routing_id,
+                                                               int32_t object_id,
+                                                               const std::string& method_name,
+                                                               const std::string& document_url,
+                                                               base::Value::List arguments,
+                                                               InvokeMethodCallback callback) {
+  base::Value::List wrapped_result;
+  content::mojom::OhGinJavascriptBridgeError error_code
+      = content::mojom::OhGinJavascriptBridgeError::kOhGinJavascriptBridgeNoError;
+  OnInvokeMethod(routing_id, object_id, document_url, method_name,
+                 std::move(arguments), &wrapped_result, &error_code);
+
+  OnInvokeMethodCallback(error_code, std::move(wrapped_result), std::move(callback));
+}
+
+void OhGinJavascriptBridgeDispatcherHost::OnInvokeMethodCallback(content::mojom::OhGinJavascriptBridgeError error_code,
+    base::Value::List wrapped_result,
+    InvokeMethodCallback callback) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    CEF_POST_TASK(CEF_UIT,
+                  base::BindOnce(&OhGinJavascriptBridgeDispatcherHost::OnInvokeMethodCallback,
+                                 weak_ptr_factory_.GetWeakPtr(), error_code,
+                                 std::move(wrapped_result), std::move(callback)));
+    return;
+  }
+
+  std::move(callback).Run(error_code, std::move(wrapped_result));
+}
+
+void OhGinJavascriptBridgeDispatcherHost::InvokeMethodAsync(const std::string& method_name,
+                                                            const std::string& document_url,
+                                                            base::Value::List arguments) {
+  if (object_receivers_.current_context().second >=
+    OhGinJavascriptBridgeDispatcherHost::MIN_NATIVE_OBJ_ID) {
+    async_task_runner_->PostTask(
+        FROM_HERE, base::BindOnce(&OhGinJavascriptBridgeDispatcherHost::OnInvokeMethodAsync,
+                                  base::Unretained(this),
+                                  object_receivers_.current_context().first.frame_routing_id,
+                                  object_receivers_.current_context().second, document_url, method_name,
+                                  std::move(arguments)));
+  } else {
+    OnInvokeMethodAsync(object_receivers_.current_context().first.frame_routing_id,
+        object_receivers_.current_context().second, document_url, method_name,
+        arguments);
+  }
+}
+
+void OhGinJavascriptBridgeDispatcherHost::InvokeMethodFlowbuf(const std::string& method_name,
+                                                              const std::string& document_url,
+                                                              base::Value::List arguments,
+                                                              base::ReadOnlySharedMemoryRegion flowbuf_region,
+                                                              InvokeMethodFlowbufCallback callback) {
+  if (!flowbuf_region.IsValid()) {
+    LOG(ERROR) << "OhGinJavascriptBridgeDispatcherHost::InvokeMethodFlowbuf flowbuf_region is invalid , run combined_args way";
+    return;
+  }
+ 
+  int fd = flowbuf_region.GetPlatformHandle();
+  int dup_fd = dup(fd);
+  if (fd < 0 || dup_fd < 0) {
+    LOG(ERROR) << "OhGinJavascriptBridgeDispatcherHost::InvokeMethodFlowbuf flowbuf_region is invalid, fd < 0 , run combined_args way";
+    return;
+  }
+ 
+  base::Value::List wrapped_result;
+  content::mojom::OhGinJavascriptBridgeError error_code
+      = content::mojom::OhGinJavascriptBridgeError::kOhGinJavascriptBridgeNoError;
+ 
+  OnInvokeMethodFlowbuf(object_receivers_.current_context().first.frame_routing_id,
+                        object_receivers_.current_context().second,
+                        document_url,
+                        method_name,
+                        std::move(arguments),
+                        dup_fd,
+                        &wrapped_result,
+                        &error_code);
+  OnInvokeMethodFlowbufCallback(error_code, std::move(wrapped_result), std::move(callback));
+}
+
+void OhGinJavascriptBridgeDispatcherHost::OnInvokeMethodFlowbufCallback(
+    content::mojom::OhGinJavascriptBridgeError error_code,
+    base::Value::List wrapped_result,
+    InvokeMethodFlowbufCallback callback) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    CEF_POST_TASK(CEF_UIT,
+                  base::BindOnce(&OhGinJavascriptBridgeDispatcherHost::OnInvokeMethodFlowbufCallback,
+                                 weak_ptr_factory_.GetWeakPtr(), error_code,
+                                 std::move(wrapped_result), std::move(callback)));
+    return;
+  }
+
+  std::move(callback).Run(error_code, std::move(wrapped_result));
+}
+
+void OhGinJavascriptBridgeDispatcherHost::GetObject(
+    int32_t object_id,
+    mojo::PendingReceiver<content::mojom::OhGinJavascriptBridgeRemoteObject> receiver) {
+  if (object_receivers_.empty()) {
+    object_receivers_.set_disconnect_handler(base::BindRepeating(
+        &OhGinJavascriptBridgeDispatcherHost::ObjectDisconnected, this));
+  }
+  object_receivers_.Add(
+      this, std::move(receiver),
+      std::make_pair(receivers_.current_context(), object_id));
+}
+
+void OhGinJavascriptBridgeDispatcherHost::ObjectDisconnected() {
+  OnObjectWrapperDeleted(object_receivers_.current_context().first.frame_routing_id,
+                         object_receivers_.current_context().second);
+}
+
+void OhGinJavascriptBridgeDispatcherHost::ObjectWrapperDeleted(int32_t object_id) {
+  (void)object_id;
+}
+
+FrameInfos OhGinJavascriptBridgeDispatcherHost::GetLastCallingFrameInfos(int32_t routing_id) {
+  FrameInfos frame_info;
+  content::WebContentsImpl* web_contents_impl =
+      static_cast<content::WebContentsImpl*>(web_contents());
+  if (!web_contents_impl) {
+    LOG(ERROR) << "OhGinJavascriptBridgeDispatcherHost::GetLastCallingFrameInfos "
+                  "web_contents_impl null";
+    return frame_info;
+  }
+ 
+  content::RenderFrameHost* target_frame =
+      web_contents_impl->AsWebContentsImplExt()
+          ->GetTargetFramesIncludingPending(routing_id);
+  if (!target_frame) {
+    LOG(ERROR) << "GetLastCallingFrameInfos failed, get RenderFrameHost failed";
+    return frame_info;
+  }
+ 
+  content::RenderFrameHostImpl* rfh = static_cast<content::RenderFrameHostImpl*>(target_frame);
+  if (!rfh) {
+    LOG(ERROR) << "GetLastCallingFrameInfos failed, dynamic_cast to content::RenderFrameHostImpl failed";
+    return frame_info;
+  }
+  auto global_id = rfh->GetGlobalId();
+  frame_info.id = std::to_string(global_id.child_id) + "_" + std::to_string(global_id.frame_routing_id);
+  if (content::RenderFrameHostImpl* parent = rfh->GetParent()) {
+    auto parent_global_id = parent->GetGlobalId();
+    frame_info.parentId = std::to_string(parent_global_id.child_id) + "_" +
+                          std::to_string(parent_global_id.frame_routing_id);
+  } else {
+    frame_info.parentId.clear();
+  }
+  LOG(DEBUG) << "OhGinJavascriptBridgeDispatcherHost::GetLastCallingFrameInfos: "
+                "id: " << frame_info.id  << ", parentId: " << frame_info.parentId;
+  return frame_info;
+}
+
+void OhGinJavascriptBridgeDispatcherHost::SetLastCallingFrameInfosOnUIThread(
+  int32_t routing_id,
+  const std::string& document_url) {
+  if (!web_contents()) {
+    return;
+  }
+ 
+  FrameInfos frame_info = GetLastCallingFrameInfos(routing_id);
+  OhJavascriptInjector* javascriptInjector =
+      OhJavascriptInjector::FromWebContents(web_contents());
+  if (javascriptInjector) {
+    javascriptInjector->SetLastCallingFrameUrl(document_url);
+    javascriptInjector->SetLastCallingFrameInfo(frame_info);
+  }
+}
