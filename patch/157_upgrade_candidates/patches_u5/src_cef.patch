+bool HitNodeBelongsToElement(const blink::WebNode& hit_node,
+                             const blink::WebElement& element) {
+  for (blink::WebNode node = hit_node; !node.IsNull();
+       node = node.ParentOrShadowHostNode()) {
+    if (node.Equals(element)) {
