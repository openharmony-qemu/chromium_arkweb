+      mouseEvent, type, mouseUp, clickCount);
+#if BUILDFLAG(ARKWEB_INPUT_EVENTS)
+  cef_browser_platform_delegate_osr_utils_->AdjustMouseEventCoordinates(view, mouseEvent, web_event);
+#endif
+
+  view->SendMouseEvent(web_event);
