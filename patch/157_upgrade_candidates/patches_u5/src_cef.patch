+  GURL gurl(tabs[0].url.value_or(""));
+  ExtensionTabUtil::ScrubTabBehavior scrub_tab_behavior =
+      ExtensionTabUtil::GetScrubTabBehaviorExt(extension(), source_context_type(), gurl, tabs[0].id.value_or(-1));
