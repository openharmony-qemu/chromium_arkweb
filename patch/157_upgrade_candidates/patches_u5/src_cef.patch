+int ArkWebBrowserHostExtImpl::PageLoadProgress() {
+  auto web_contents = GetWebContents();
+  if (web_contents) {
+    if (!web_contents->IsLoading()) {
+      return 100;
+    }
+    return round(100 * web_contents->GetLoadProgress());
+  }
+  return 0;
+}
