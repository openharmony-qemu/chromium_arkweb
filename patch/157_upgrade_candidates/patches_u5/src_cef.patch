+void ArkWebBrowserHostExtImpl::PostPortMessage(const CefString& portHandle,
+                                               CefRefPtr<CefValue> data) {
+  sequenced_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ArkWebBrowserHostExtImpl::PostPortMessageInternal, this,
+                     portHandle, data));
+}
