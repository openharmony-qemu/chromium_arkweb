+bool CheckUrlPath(base::FilePath url_path, CefString& path) {
+    auto file_path =
+        base::MakeAbsoluteFilePathNoResolveSymbolicLinks(base::FilePath(path))
+            .value_or(base::FilePath());
+    if (file_path.empty()) {
+      return false;
+    }
+    if (file_path == url_path || file_path.IsParent(url_path)) {
+      return true;
+    }
+    return false;
+}
