+  const auto& dict = parsed->GetDict();
+  EXPECT_EQ(dict.FindInt("pageCount").value_or(-1), 0);
+  EXPECT_EQ(dict.FindInt("resultCode").value_or(-1), kNoPageErrorCode);
+  ASSERT_NE(dict.FindString("resultMessage"), nullptr);
