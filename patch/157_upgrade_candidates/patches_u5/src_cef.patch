+ohos_safe_browsing::SafeBrowsingSnapshotManager::PendingFmp 
+SafeBrowsingSnapshotManager::GetPendingFmp() const 
+{
+    std::shared_lock<std::shared_mutex> lock(data_mutex_);
+    return pending_fmp_;
+}
