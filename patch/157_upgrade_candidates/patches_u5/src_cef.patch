+AlloyBrowserHostImplExt::OnFullScreenOverlayEnter(
+    media::mojom::MediaInfoForVASTPtr media_info_ptr,
+    const content::MediaPlayerId& media_player_id) {
+  if (!client_) {
+    LOG(WARNING) << "client is null, OnFullScreenOverlayEnter failed";
+    return nullptr;
