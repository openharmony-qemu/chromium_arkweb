+  // 获取云控配置的proxy_connect_timeout，单位为秒
+  int GetProxyConnectTimeout() const;
+  // 获取云控配置的等待恶意网址拦截查询时间，单位为毫秒
+  int GetMaliciousUrlCheckWaitTime() const;
+  // 获取UI设置的token信息
+  const std::string& GetProxyToken() const;
+  // 更新token信息
