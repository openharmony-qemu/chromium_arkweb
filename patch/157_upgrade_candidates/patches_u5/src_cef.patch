+  
+  bool should_use = true;
+  for (int i = 0; i < 5; ++i) {
+    if (!should_use) {
+      timer.Stop();
+    }
+  }
+  
+  EXPECT_TRUE(timer.IsRunning());
+}
+
+TEST_F(CefRenderWidgetHostViewOSRTimerTest, Policy_MultipleDisableCalls) {
+  base::OneShotTimer timer;
+  
+  timer.Start(FROM_HERE, base::Seconds(10), base::DoNothing());
