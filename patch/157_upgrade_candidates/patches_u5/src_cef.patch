+bool CefCookieManagerImplExt::VisitUrlCookies(
+    const CefString& url,
+    bool includeHttpOnly,
+    CefRefPtr<CefCookieVisitor> visitor,
+    bool is_sync,
+    bool is_from_ndk) {
+  if (!visitor.get()) {
