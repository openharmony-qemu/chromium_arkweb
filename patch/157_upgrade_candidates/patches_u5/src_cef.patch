+#if BUILDFLAG(IS_ARKWEB)
+static scoped_refptr<net::SSLPrivateKey> WrapOpenSSLPrivateKey(
+    bssl::UniquePtr<EVP_PKEY> key) {
+  if (!key) {
+    return nullptr;
+  }
