+int g_input_uid = 0;
+
+const char kCurrentTabDisposition[] = "currentTab";
+const char kForegroundTabDisposition[] = "newForegroundTab";
+const char kBackgroundTabDisposition[] = "newBackgroundTab";
+
+}  // namespace
