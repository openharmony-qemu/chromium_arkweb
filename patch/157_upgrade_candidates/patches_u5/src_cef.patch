+  nweb_ex::NWebExtensionContextMenusDelegateImpl::GetInstance().OnCreateNativeByPb(extension_id, item_v2);
+#endif
+}
+ 
+NO_SANITIZE("cfi-icall")
+void CefWebExtensionMenuManager::OnContextMenusUpdate(
+    const std::string& extension_id,
