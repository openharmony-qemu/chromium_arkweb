+
+void ArkwebFrameHostExtImpl::OnGetImageByXPathTask(
+    int32_t taskid,
+    uint32_t buffer_size,
+    base::ReadOnlySharedMemoryRegion region,
+    uint32_t width,
+    uint32_t height,
+    int32_t image_id) {
+    auto browser = GetBrowserHostBase();
+    if (!browser) {
+      return;
+    }
+  
+    CefRefPtr<CefContextMenuHandler> handler;
+    auto client = browser->GetClient();
+    if (client) {
+      handler = client->GetContextMenuHandler();
+    }
+    if (!handler) {
+      return;
+    }
+ 
+    CefImageImpl* image_impl = new (std::nothrow) CefImageImpl();
+    if (!image_impl) {
+      LOG(ERROR) << "OnGetImageByXPath: Failed to allocate CefImageImpl";
+      handler->AsCefContextMenuHandlerExt()->OnGetImageByXPath(taskid, nullptr, image_id);
+      return;
+    }
+    if (!region.IsValid()) {
+      LOG(ERROR)
+          << "OnGetImageByXPath: Read-only shared memory region is invalid";
+      handler->AsCefContextMenuHandlerExt()->OnGetImageByXPath(taskid, image_impl, image_id);
+      return;
+    }
+    base::ReadOnlySharedMemoryMapping mapping = region.MapAt(0, buffer_size);
+    if (!mapping.IsValid()) {
+      LOG(ERROR)
+          << "OnGetImageByXPath: Read-only shared memory mapping is invalid";
+      handler->AsCefContextMenuHandlerExt()->OnGetImageByXPath(taskid, image_impl, image_id);
+      return;
+    }
+    SkImageInfo info = SkImageInfo::MakeN32Premul(width, height);
+    void* pixels = const_cast<void*>(mapping.memory());
+    SkBitmap bitmap;
+    bool installed = bitmap.installPixels(
+      info,
+      pixels,
+      info.minRowBytes()
+    );
+    if (!installed) {
+      handler->AsCefContextMenuHandlerExt()->OnGetImageByXPath(taskid, image_impl, image_id);
+      return;
+    }
+  
+    bitmap.setImmutable();
+    image_impl->AddBitmap(1.0, bitmap);
+    handler->AsCefContextMenuHandlerExt()->OnGetImageByXPath(taskid, image_impl, image_id);
+    return;
+}
