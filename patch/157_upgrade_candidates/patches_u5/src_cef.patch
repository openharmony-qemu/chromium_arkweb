+    return false;
+  }
+  OHOS::NWeb::OhosWebPermissionDataBaseAdapter& databaseAdapter =
+      OHOS::NWeb::OhosAdapterHelper::GetInstance()
+          .GetWebPermissionDataBaseInstance();
