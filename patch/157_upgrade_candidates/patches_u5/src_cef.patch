+        ->OnClippedSelectionBoundsChanged(clipped_selection_bounds_,
+                                          need_report);
+    rwhv_->AsArkWebRenderWidgetHostViewOSRExt()->OnTouchSelectionChanged(
+        insert_handle, start_selection_handle, end_selection_handle,
+        need_report);
+  }
