+  auto parsed = base::JSONReader::Read(*result, base::JSONParserOptions::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  ASSERT_TRUE(parsed.has_value());
+  ASSERT_TRUE(parsed->is_dict());
