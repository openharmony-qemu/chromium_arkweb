+namespace {
+blink::WebHitTestResult HitTestResultForTap(blink::WebView* web_view,
+                                            const gfx::Point& tap_point,
+                                            const gfx::Size& tap_area) {
+  if (!web_view) {
+    return blink::HitTestResult();
+  }
+
+  blink::WebViewImpl* web_view_impl = blink::DynamicTo<blink::WebViewImpl>(web_view);
+  if (!web_view_impl || !web_view_impl->GetPage()) {
+    return blink::HitTestResult();
+  }
+
+  auto* main_frame =
+      blink::DynamicTo<blink::LocalFrame>(web_view_impl->GetPage()->MainFrame());
+  if (!main_frame) {
+    return blink::HitTestResult();
+  }
+  blink::WebLocalFrameImpl* local_frame_impl =
+      blink::WebLocalFrameImpl::FromFrame(main_frame);
+  if (!local_frame_impl) {
+    return blink::HitTestResult();
+  }
+
+  blink::WebGestureEvent tap_event(blink::WebInputEvent::Type::kGestureTap,
+                                   blink::WebInputEvent::kNoModifiers, base::TimeTicks::Now(),
+                                   blink::WebGestureDevice::kTouchscreen);
+  // GestureTap is only ever from a touchscreen.
+  tap_event.SetPositionInWidget(gfx::PointF(tap_point));
+  tap_event.data.tap.tap_count = 1;
+  tap_event.data.tap.width = tap_area.width();
+  tap_event.data.tap.height = tap_area.height();
+
+  blink::WebGestureEvent scaled_event =
+      blink::TransformWebGestureEvent(local_frame_impl->GetFrameView(), tap_event);
+
+  blink::HitTestResult result =
+#if BUILDFLAG(ARKWEB_MENU)
+      main_frame->GetEventHandler()
+          .HitTestResultForGestureEvent(scaled_event,
+                                        blink::HitTestRequest::kReadOnly |
+                                            blink::HitTestRequest::kActive |
+                                            blink::HitTestRequest::kOnDoHitTest)
+          .GetHitTestResult();
+#else
+      main_frame->GetEventHandler()
+          .HitTestResultForGestureEvent(
+              scaled_event, blink::HitTestRequest::kReadOnly | blink::HitTestRequest::kActive)
+          .GetHitTestResult();
+#endif  // BUILDFLAG(ARKWEB_MENU)
+
+  result.SetToShadowHostIfInUAShadowRoot();
+  return result;
+}
