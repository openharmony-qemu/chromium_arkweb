+net::FallbackProxyStatus
+FallbackProxyService::GetFallbackProxyStatusByDisabledReason(
+    DisabledReason reason) {
+  switch (reason) {
+    case CONFIG_DISABLED:
+      return net::FallbackProxyStatus::DISABLE_BY_CLOUD_CONTROL;
