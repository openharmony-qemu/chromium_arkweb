+  EventRouter::Get(browser_context)->BroadcastEvent(std::move(event));
+}
+
+void CefWindowsEventRouter::DispatchWindowFocusChangedEvent(content::BrowserContext* browser_context,
+                                                            const WebExtensionWindow& window) {
