+  // console.log(Object.keys(delegate));
+  assertStringArrayEqual(
+    Object.keys(delegate),
+    getAllEnumerableStringPropertyKeys(underlying, true, (name) => {
+      return name.startsWith("_") | name.startsWith("$");
+    }),
