+
+    glDeleteBuffers(1, &idA);
+
+    GLuint idB;
+    glGenBuffers(1, &idB);
+    EXPECT_NE(idA, idB);
+
+    glDeleteVertexArrays(1, &vao);
+    glDeleteBuffers(1, &idB);
+}
