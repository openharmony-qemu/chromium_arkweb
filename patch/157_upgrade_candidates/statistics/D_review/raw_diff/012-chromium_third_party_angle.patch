+    {
+        return angle::Result::Continue;
+    }
+
+    angle::Result pause(const gl::Context *) override
+    {
+        mPauseCount++;
+        return angle::Result::Continue;
+    }
+    angle::Result resume(const gl::Context *) override
+    {
+        mResumeCount++;
+        return mResumeResult;
+    }
+
+    void setResumeResult(angle::Result result) { mResumeResult = result; }
