diff --git a/third_party/blink/web_tests/external/wpt/css/css-variables/transition-with-attribute-taint.html b/third_party/blink/web_tests/external/wpt/css/css-variables/transition-with-attribute-taint.html
new file mode 100644
index 0000000000000000000000000000000000000000..a5f8fbe2caabdbe2538ed49cba52d7d43c96eb7d
--- /dev/null
+++ b/third_party/blink/web_tests/external/wpt/css/css-variables/transition-with-attribute-taint.html
@@ -0,0 +1,66 @@
+<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <link rel="help" href="https://drafts.csswg.org/css-values-5/#attr-security">
+  <script src="/resources/testharness.js"></script>
+  <script src="/resources/testharnessreport.js"></script>
+  <script src="/web-animations/testcommon.js"></script>
+  <title>attr()-taint in CSS transition</title>
+</head>
+<style>
+  @property --src {
+    syntax: "<number>";
+    inherits: true;
+    initial-value: 0;
+  }
+  @property --n {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+  }
+
+  @keyframes mask {
+    from { --src: 0; }
+    to   { --src: 0; }
+  }
+
+  #target {
+    background-color: rebeccapurple;
+    width: 200px;
+    height: 200px;
+    transition: --n 1000s steps(1, end);
+  }
+
+  #target.stage1 {
+    --src: attr(data-secret type(<number>));
+    --n: var(--src);
+    animation: mask 1000s linear;
+  }
+
+  #target.stage2 {
+    animation: none;
+    --n: -1;
+    background-image:
+      /* transition start value is attr()-tainted. Ensure it is not leaked. */
+      if(style(--n: 7193): url("/leaked/secret.html"); else: none);
+  }
+
+</style>
+<body>
+  <div id="target"  data-secret="7193" class="stage1"></div>
+</body>
+<script>
+  promise_test(async () => {
+    const target  = document.getElementById('target');
+    getComputedStyle(target).getPropertyValue('--n');
+    await runAndWaitForFrameUpdate(() => {
+      target.classList.remove('stage1');
+      target.classList.add('stage2');
+    });
+    const bg  = getComputedStyle(target).getPropertyValue('background-image');
+    assert_equals(bg, 'none');
+  }, 'Attribute tainted value blocked');
+</script>
+</html>
diff --git a/third_party/blink/web_tests/external/wpt/css/cssom/adoptedstylesheets-observablearray.html b/third_party/blink/web_tests/external/wpt/css/cssom/adoptedstylesheets-observablearray.html
index 783a0541633d3f2b5fdfae90c364ffa8350be561..1bab86e1a2b61abcc4ef64bb9dfeb9871e8341ff 100644
--- a/third_party/blink/web_tests/external/wpt/css/cssom/adoptedstylesheets-observablearray.html
+++ b/third_party/blink/web_tests/external/wpt/css/cssom/adoptedstylesheets-observablearray.html
@@ -89,4 +89,37 @@ test(function() {
   const shadow = host.attachShadow({mode: 'open'});
   assert_true(Array.isArray(shadow.adoptedStyleSheets));
 }, "adoptedStyleSheets should return true for isArray()");
+
+test(function() {
+  // A prototype-less descriptor keeps Object.defineProperty() below working
+  // once Object.prototype.get is a number.
+  const numeric = Object.create(null);
+  numeric.value = 1;
+  numeric.writable = true;
+  numeric.configurable = true;
+  const descriptor = new Proxy(Object.create(null), {
+    has(target, key) {
+      if (key === "set") {
+        // Runs while the descriptor is being converted, after the initial
+        // conversion has already looked up "get".
+        Object.defineProperty(Object.prototype, "get", numeric);
+        Object.defineProperty(Object.prototype, "set", numeric);
+      }
+      return false;
+    },
+  });
+  try {
+    assert_throws_js(TypeError, () => {
+      Reflect.defineProperty(document.adoptedStyleSheets, "reentrantAccessor",
+                             descriptor);
+    });
+  } finally {
+    delete Object.prototype.get;
+    delete Object.prototype.set;
+  }
+  assert_equals(
+      Object.getOwnPropertyDescriptor(document.adoptedStyleSheets,
+                                      "reentrantAccessor"),
+      undefined);
+}, "adoptedStyleSheets defineProperty should reject accessors that become non-callable during descriptor conversion");
 </script>
