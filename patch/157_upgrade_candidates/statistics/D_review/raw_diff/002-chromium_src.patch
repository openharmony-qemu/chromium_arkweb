+TEST(OutputPresenterOhosTest, PendingFrameNegativeZOrderOffset) {
+  CHECK_DELEGATE_ENABLED_PRESENTER();
+    std::vector<int32_t> z_orders = {2, -1, 0, 1, -2};
+  std::sort(z_orders.begin(), z_orders.end());
