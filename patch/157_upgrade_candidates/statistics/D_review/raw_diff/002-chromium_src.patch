+      context_->presentation_request().render_frame_host_id);
+  if (!initiator_rfh) {
+    context_.reset();
+    return false;
+  }
+  auto* web_contents =
+      content::MediaSession::GetWebContentsFromRequestId(session_id);
+  return web_contents && content::WebContents::FromRenderFrameHost(
+                             initiator_rfh) == web_contents;
+}
