-    targetContainer.addEventListener(eventType, handleMutationEvent, true);
-    document.addEventListener(eventType, handleMutationEvent, true);
-  });
-  
-  // 推荐使用MutationObserver，下面是等价代码:
-  // 在页面加载完毕时或者合适的时候主动添加监听
