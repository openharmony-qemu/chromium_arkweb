+         eof_check!("<!"       ; 0, 2);
++        eof_check!("/"        ; 0, 1);
++        eof_check!("]"        ; 0, 1);
+         eof_check!("<!-"      ; 0, 3);
+         eof_check!("<!["      ; 0, 3);
+         eof_check!("<![C"     ; 0, 4);
+-- 
