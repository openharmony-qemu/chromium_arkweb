+
+  base::FilePath path;
+  if (!net::FileURLToFilePath(url, &path)) {
+    return url;
+  }
+
+  std::string encoded = base::EscapePath(path.value());
+
+  GURL::Replacements replacements;
+  replacements.SetPathStr(encoded);
+  return url.ReplaceComponents(replacements);
+}
