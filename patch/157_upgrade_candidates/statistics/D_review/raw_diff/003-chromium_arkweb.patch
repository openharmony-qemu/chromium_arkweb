+ * @tc.type: FUNC
+ */
+TEST_F(AIPageCommandDispatcherTest,
+       ValidateZoomLevelParam_OutOfRange_Low_ReturnsFalse_0100) {
+  base::Value::Dict params;
+  params.Set("zoomLevel", 0.1);
