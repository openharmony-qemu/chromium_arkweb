+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        delay_clean_buffer_task_closure_->callback(),
+        base::Milliseconds(CLEAN_BUFFERS_TIME_INTERVAL_MIN * 2));
+      has_delay_clean_buffer_task_ = true;
+    }
+    return true;
+  }
+  return false;
+}
