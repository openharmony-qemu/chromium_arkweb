+  EXPECT_TRUE(result->extensions->echo_large_blob_written);
+  EXPECT_TRUE(result->extensions->large_blob_written);
+  ASSERT_TRUE(result->extensions->large_blob);
+  EXPECT_EQ(*result->extensions->large_blob,
