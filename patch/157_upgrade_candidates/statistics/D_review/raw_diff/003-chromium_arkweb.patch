+    // EM OV CS CA - G3B
+    SHA256HashValue{{0xec, 0x4f, 0xfa, 0x1a, 0xd0, 0xac, 0x88, 0x08, 0x13,
+                     0x14, 0xb7, 0xaa, 0xff, 0xef, 0x6a, 0x91, 0xf9, 0x7c,
