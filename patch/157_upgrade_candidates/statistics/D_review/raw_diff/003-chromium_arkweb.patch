+using PollMockFn = std::function<int(struct pollfd*, nfds_t, int)>;
+
+PollMockFn& PollMock() {
+  static PollMockFn mock;
+  return mock;
+}
+
+class ScopedPollMock {
+ public:
+  explicit ScopedPollMock(PollMockFn mock) { PollMock() = std::move(mock); }
+  ~ScopedPollMock() { PollMock() = PollMockFn(); }
+};
