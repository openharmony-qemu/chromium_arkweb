+void StopHiTraceConsumerSession() {
+  if (HiTraceConsumerSession()) {
+    HiTraceConsumerSession()->StopBlocking();
+    HiTraceConsumerSession().reset();
+    LOG(INFO) << "[HiTrace-Interceptor] consumer session stopped";
+  }
+}
