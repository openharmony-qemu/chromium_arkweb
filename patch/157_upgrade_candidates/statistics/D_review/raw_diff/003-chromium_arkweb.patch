+    if (!result->Wait(kGetPasteDataTimeout)) {
+      LOG(ERROR) << "GetPasteData timeout after "
+                 << kGetPasteDataTimeout.InMilliseconds() << " ms";
+      g_get_paste_data_pending.store(false);
