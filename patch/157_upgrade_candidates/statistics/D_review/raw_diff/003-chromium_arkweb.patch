+  scoped_refptr<gpu::RefCountedLock> drdc_lock =
+      base::MakeRefCounted<gpu::RefCountedLock>();
+  gpu::Mailbox mailbox = gpu::Mailbox::Generate();
+  auto image = base::MakeRefCounted<CodecImage>(spec.coded_size, drdc_lock);
