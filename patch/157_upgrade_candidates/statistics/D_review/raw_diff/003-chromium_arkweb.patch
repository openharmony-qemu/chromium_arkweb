+                     0x5f, 0x5e, 0xb4, 0xf6, 0xb6}},
+};
+ 
+}  // namespace
+ 
+// static
+bool CertBlockedCaCertificatesOHOS::IsBlocked(const SHA256HashValue& spki_hash) {
+  for (const auto& blocked : kBlockedSpkiHashes) {
+    if (spki_hash == blocked) {
+      return true;
+    }
+  }
+  return false;
+}
+ 
+// static
+bool CertBlockedCaCertificatesOHOS::IsChainBlocked(
+    const std::vector<SHA256HashValue>& spki_hashes) {
+  for (const auto& hash : spki_hashes) {
+    if (IsBlocked(hash)) {
+      LOG(ERROR) << "CertBlockedCaCertificatesOHOS: certificate chain contains a "
+                 << "blocked intermediate CA (SPKI SHA-256: "
+                 << base::HexEncode(hash.data(), hash.size()) << ")";
+      return true;
+    }
+  }
+  return false;
+}
