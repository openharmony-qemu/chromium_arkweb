+
+    // Set up valid plane data (Y: 16*16=256, U: 8*8=64, V: 8*8=64 for I420 with stride 16)
+    std::unique_ptr<uint8_t[]> y_data = std::make_unique<uint8_t[]>(256);
+    std::unique_ptr<uint8_t[]> u_data = std::make_unique<uint8_t[]>(64);
