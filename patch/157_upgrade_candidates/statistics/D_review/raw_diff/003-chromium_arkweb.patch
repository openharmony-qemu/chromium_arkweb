+class MockDevToolsNetworkEventSink : public DevToolsNetworkEventSink {
+ public:
+  MOCK_METHOD(void,
+              NotifyRequestWillBeSent,
+              (const std::string&, const network::ResourceRequest&),
+              (override));
+  MOCK_METHOD(void,
