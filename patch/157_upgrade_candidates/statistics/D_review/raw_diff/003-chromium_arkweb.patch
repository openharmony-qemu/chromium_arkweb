+  g_gc_funcs.registerDpadUp(OnGamePadButtonEvent);
+  g_gc_funcs.registerDpadDown(OnGamePadButtonEvent);
+  g_gc_funcs.registerDpadLeft(OnGamePadButtonEvent);
