diff --git a/chromium_ext/ohos_test/fuzztest/ohos_nweb/src/cef_delegate/nweb_event_handler_fuzzer.cc b/chromium_ext/ohos_test/fuzztest/ohos_nweb/src/cef_delegate/nweb_event_handler_fuzzer.cc
index b662cdc42ba38e8a7f07652764e533de5442f2af..077b212ec732a40c714b396ea905dbe80e19deda 100644
--- a/chromium_ext/ohos_test/fuzztest/ohos_nweb/src/cef_delegate/nweb_event_handler_fuzzer.cc
