+BASE_EXPORT bool IsOhosLowEndDevice() {
+  static bool is_low_end_device = []() -> bool {
+    int ohos_device_end_type = OHOS::NWeb::OhosAdapterHelper::GetInstance()
+                                 .GetSystemPropertiesInstance()
+                                 .GetIntParameter("web.device_end.type", 0);
+    // CCM low-end mode switch controlled by cloud configuration.
+    // - 0: Default (auto-detected based on physical memory size)
+    // - 1: Low-end device
+    // - 2: High-end device
+    if (ohos_device_end_type == 1) {
+      return true;
+    }
+    if (ohos_device_end_type == 2) {
+      return false;
+    }
+
+    // Set phone device which physical memory under 6G as Low-end
+    return IsMobileDevice() && SysInfo::AmountOfPhysicalMemory() <= base::GiB(6);
+  }();
+  return is_low_end_device;
+}
+
+BASE_EXPORT bool IsDelegatedCompositingEnabledOhos() {
+  if (!features::IsDelegatedCompositingFeatureEnabledOhos()) {
+    return false;
+  }
+
+  static const bool is_delegated_enabled =
+      OHOS::NWeb::OhosAdapterHelper::GetInstance()
+          .GetSystemPropertiesInstance()
+          .GetBoolParameter("web.delegatedCompositing.enable", false);
+  if (!is_delegated_enabled) {
+    return false;
+  }
+
+  static const bool is_delegated_enabled_test =
+      OHOS::NWeb::OhosAdapterHelper::GetInstance()
+          .GetSystemPropertiesInstance()
+          .GetBoolParameter("web.delegatedCompositingTest.enable", false);
+  if (is_delegated_enabled_test) {
+    return true;
+  }
+
+  static const bool is_nweb_ex_delegated_enabled =
+      base::CommandLine::ForCurrentProcess() &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch(
+          ::switches::kEnableNwebExDelegateCompositing);
+
+  return is_nweb_ex_delegated_enabled;
+}
+
+BASE_EXPORT bool IsAiHdrEnabledOhos() {
+  if (!IsDelegatedCompositingEnabledOhos()) {
+    return false;
+  }
+  static const bool is_aihdr_enabled =
+      OHOS::NWeb::OhosAdapterHelper::GetInstance()
+          .GetSystemPropertiesInstance()
+          .GetBoolParameter("web.aihdr.enable", false);
+  return is_aihdr_enabled;
+}
 }  // namespace ohos
 
 }  // namespace base
