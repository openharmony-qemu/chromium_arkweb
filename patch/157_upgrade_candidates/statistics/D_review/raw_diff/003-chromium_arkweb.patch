+  EXPECT_EQ(result,
+            NavigationController::NavigationEntryUpdateError::UPDATE_OK);
+  // Now entries_.size() == 1, so index 1 should be valid (append)
+  result =
+      controller().InsertBackForwardEntry(1, GURL("https://www.second.com/"));
