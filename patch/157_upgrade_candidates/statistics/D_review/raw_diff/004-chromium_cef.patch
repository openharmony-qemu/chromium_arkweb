+  const std::string *value = dict->FindString(key);
+  return value && !value->empty() ? *value : fallback;
+}
+
+double ReadDictNumber(const base::Value::Dict *dict, const char *key,
+                      double fallback) {
+  if (!dict) {
+    return fallback;
