+  if (!load_handler.get()) {
+    LOG(WARNING) << "NotifySafeBrowsingHit: load_handler is null";
+    return;
+  }
+  int threat = static_cast<int>(block_type);
+  load_handler->AsArkWebLoadHandlerExt()->OnSafeBrowsingHit(
+      url.spec(), code, policy, threat, response_key);
